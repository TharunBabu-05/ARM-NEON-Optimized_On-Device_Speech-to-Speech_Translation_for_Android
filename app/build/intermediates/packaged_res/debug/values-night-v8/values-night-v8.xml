<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="background_primary_night">#0F172A</color>
    <color name="background_secondary_night">#1E293B</color>
    <color name="divider_night">#334155</color>
    <color name="primary_dark_night">#6366F1</color>
    <color name="primary_light_night">#1E1B4B</color>
    <color name="primary_night">#818CF8</color>
    <color name="primary_variant_night">#312E81</color>
    <color name="secondary_dark_night">#14B8A6</color>
    <color name="secondary_night">#2DD4BF</color>
    <color name="secondary_variant_night">#134E4A</color>
    <color name="surface_accent_night">#0D3D56</color>
    <color name="surface_night">#1E293B</color>
    <color name="surface_variant_night">#334155</color>
    <color name="text_hint_night">#64748B</color>
    <color name="text_primary_night">#F8FAFC</color>
    <color name="text_secondary_night">#94A3B8</color>
    <style name="Theme.VoiceTranslator" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/primary_night</item>
        <item name="colorPrimaryDark">@color/primary_dark_night</item>
        <item name="colorPrimaryVariant">@color/primary_variant_night</item>
        <item name="colorOnPrimary">@color/white</item>
        
        
        <item name="colorSecondary">@color/secondary_night</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_night</item>
        <item name="colorOnSecondary">@color/white</item>
        
        
        <item name="android:colorBackground">@color/background_primary_night</item>
        <item name="colorSurface">@color/surface_night</item>
        <item name="colorSurfaceVariant">@color/surface_variant_night</item>
        <item name="colorOnSurface">@color/text_primary_night</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_night</item>
        
        
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        
        
        <item name="android:statusBarColor">@color/background_primary_night</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/background_primary_night</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">false</item>
        
        
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.VoiceTranslator.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>